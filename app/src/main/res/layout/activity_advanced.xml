<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:paddingStart="16dp"
    android:paddingEnd="16dp"
    android:paddingTop="16dp"
    android:paddingBottom="16dp"
    tools:ignore="HardcodedText">

    <!-- Экран вывода / ввода -->
    <TextView
        android:id="@+id/tvDisplay"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:gravity="end|bottom"
        android:textSize="36sp"
        android:text="0" />

    <!-- Кнопка переключения режимов -->
    <Button
        android:id="@+id/btnAdvSwitch"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Обычный режим" />

    <!-- Сетка кнопок калькулятора -->
    <GridLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:columnCount="5"
        android:rowCount="7">

        <!-- Ряд 1 -->
        <Button android:id="@+id/btn2nd" android:text="2nd" />
        <Button android:id="@+id/btnDeg" android:text="deg" />
        <Button android:id="@+id/btnSin" android:text="sin" />
        <Button android:id="@+id/btnCos" android:text="cos" />
        <Button android:id="@+id/btnTan" android:text="tan" />

        <!-- Ряд 2 -->
        <Button android:id="@+id/btnPow" android:text="xʸ" />
        <Button android:id="@+id/btnLg" android:text="lg" />
        <Button android:id="@+id/btnLn" android:text="ln" />
        <Button android:id="@+id/btnOpenBracket" android:text="(" />
        <Button android:id="@+id/btnCloseBracket" android:text=")" />

        <!-- Ряд 3 -->
        <Button android:id="@+id/btnSqrt" android:text="√x" />
        <Button android:id="@+id/btnClear" android:text="C" />
        <Button android:id="@+id/btnBackspace" android:text="⌫" />
        <Button android:id="@+id/btnPercent" android:text="%" />
        <Button android:id="@+id/btnDivide" android:text="÷" />

        <!-- Ряд 4 -->
        <Button android:id="@+id/btnFact" android:text="x!" />
        <Button android:id="@+id/btn7" android:text="7" />
        <Button android:id="@+id/btn8" android:text="8" />
        <Button android:id="@+id/btn9" android:text="9" />
        <Button android:id="@+id/btnMultiply" android:text="×" />

        <!-- Ряд 5 -->
        <Button android:id="@+id/btnReciprocal" android:text="1/x" />
        <Button android:id="@+id/btn4" android:text="4" />
        <Button android:id="@+id/btn5" android:text="5" />
        <Button android:id="@+id/btn6" android:text="6" />
        <Button android:id="@+id/btnMinus" android:text="-" />

        <!-- Ряд 6 -->
        <Button android:id="@+id/btnPi" android:text="π" />
        <Button android:id="@+id/btn1" android:text="1" />
        <Button android:id="@+id/btn2" android:text="2" />
        <Button android:id="@+id/btn3" android:text="3" />
        <Button android:id="@+id/btnPlus" android:text="+" />

        <!-- Ряд 7 -->
        <Button android:id="@+id/btnShift" android:text="⇇" />
        <Button android:id="@+id/btnE" android:text="e" />
        <Button android:id="@+id/btn0" android:text="0" />
        <Button android:id="@+id/btnComma" android:text="," />
        <Button android:id="@+id/btnEqual" android:text="=" />

    </GridLayout>
</LinearLayout>