<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#000000"
    android:padding="8dp">

    <!-- Гарантированное место под поле ввода -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:gravity="bottom|end"
        android:orientation="vertical"
        android:padding="8dp">

        <TextView
            android:id="@+id/tvExpression"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="end"
            android:textColor="#FFFFFF"
            android:textSize="40sp"
            android:maxLines="2" />

        <TextView
            android:id="@+id/tvResult"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="end"
            android:textColor="#888888"
            android:textSize="26sp"
            android:layout_marginTop="4dp" />
    </LinearLayout>

    <!-- Сетка 5x7 -->
    <GridLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="2.5"
        android:columnCount="5"
        android:rowCount="7"
        android:alignmentMode="alignMargins">

        <!-- Ряд 1 -->
        <Button android:id="@+id/btn2nd" style="@style/CalcButton" android:text="@string/btn_2nd" android:textSize="15sp" />
        <Button android:id="@+id/btnDeg" style="@style/CalcButton" android:text="@string/btn_deg" android:textSize="15sp" />
        <Button android:id="@+id/btnSin" style="@style/CalcButton" android:text="@string/btn_sin" android:textSize="15sp" />
        <Button android:id="@+id/btnCos" style="@style/CalcButton" android:text="@string/btn_cos" android:textSize="15sp" />
        <Button android:id="@+id/btnTan" style="@style/CalcButton" android:text="@string/btn_tan" android:textSize="15sp" />

        <!-- Ряд 2 -->
        <Button android:id="@+id/btnPow" style="@style/CalcButton" android:text="@string/btn_pow" android:textSize="15sp" />
        <Button android:id="@+id/btnLg" style="@style/CalcButton" android:text="@string/btn_lg" android:textSize="15sp" />
        <Button android:id="@+id/btnLn" style="@style/CalcButton" android:text="@string/btn_ln" android:textSize="15sp" />
        <Button android:id="@+id/btnOpenParen" style="@style/CalcButton" android:text="@string/btn_open_paren" android:textSize="16sp" />
        <Button android:id="@+id/btnCloseParen" style="@style/CalcButton" android:text="@string/btn_close_paren" android:textSize="16sp" />

        <!-- Ряд 3 -->
        <Button android:id="@+id/btnSqrt" style="@style/CalcButton" android:text="@string/btn_sqrt" android:textSize="15sp" />
        <Button android:id="@+id/btnC" style="@style/CalcButton" android:text="@string/btn_c" android:textColor="#FF6D00" android:textSize="18sp" />
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnDelete"
            style="@style/CalcButton"
            app:icon="@android:drawable/ic_input_delete"
            app:iconTint="#FF6D00"
            android:contentDescription="@string/desc_delete" />
        <Button android:id="@+id/btnPercent" style="@style/CalcButton" android:text="@string/btn_percent" android:textColor="#FF6D00" android:textSize="16sp" />
        <Button android:id="@+id/btnDivide" style="@style/CalcButton" android:text="@string/btn_divide" android:textColor="#FF6D00" android:textSize="18sp" />

        <!-- Ряд 4 -->
        <Button android:id="@+id/btnFact" style="@style/CalcButton" android:text="@string/btn_fact" android:textSize="15sp" />
        <Button android:id="@+id/btn7" style="@style/CalcButton" android:text="@string/btn_7" android:textSize="18sp" />
        <Button android:id="@+id/btn8" style="@style/CalcButton" android:text="@string/btn_8" android:textSize="18sp" />
        <Button android:id="@+id/btn9" style="@style/CalcButton" android:text="@string/btn_9" android:textSize="18sp" />
        <Button android:id="@+id/btnMultiply" style="@style/CalcButton" android:text="@string/btn_multiply" android:textColor="#FF6D00" android:textSize="18sp" />

        <!-- Ряд 5 -->
        <Button android:id="@+id/btnInv" style="@style/CalcButton" android:text="@string/btn_inv" android:textSize="15sp" />
        <Button android:id="@+id/btn4" style="@style/CalcButton" android:text="@string/btn_4" android:textSize="18sp" />
        <Button android:id="@+id/btn5" style="@style/CalcButton" android:text="@string/btn_5" android:textSize="18sp" />
        <Button android:id="@+id/btn6" style="@style/CalcButton" android:text="@string/btn_6" android:textSize="18sp" />
        <Button android:id="@+id/btnMinus" style="@style/CalcButton" android:text="@string/btn_minus" android:textColor="#FF6D00" android:textSize="18sp" />

        <!-- Ряд 6 -->
        <Button android:id="@+id/btnPi" style="@style/CalcButton" android:text="@string/btn_pi" android:textSize="15sp" />
        <Button android:id="@+id/btn1" style="@style/CalcButton" android:text="@string/btn_1" android:textSize="18sp" />
        <Button android:id="@+id/btn2" style="@style/CalcButton" android:text="@string/btn_2" android:textSize="18sp" />
        <Button android:id="@+id/btn3" style="@style/CalcButton" android:text="@string/btn_3" android:textSize="18sp" />
        <Button android:id="@+id/btnPlus" style="@style/CalcButton" android:text="@string/btn_plus" android:textColor="#FF6D00" android:textSize="18sp" />

        <!-- Ряд 7 -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnSwitchBack"
            style="@style/CalcButton"
            app:icon="@android:drawable/ic_menu_revert"
            app:iconTint="#FF6D00"
            android:contentDescription="@string/desc_switch_back" />
        <Button android:id="@+id/btnE" style="@style/CalcButton" android:text="@string/btn_e" android:textSize="15sp" />
        <Button android:id="@+id/btn0" style="@style/CalcButton" android:text="@string/btn_0" android:textSize="18sp" />
        <Button android:id="@+id/btnDot" style="@style/CalcButton" android:text="@string/btn_dot" android:textSize="18sp" />
        <Button android:id="@+id/btnEquals" style="@style/CalcButton" android:backgroundTint="#FF6D00" android:text="@string/btn_equals" android:textColor="#FFFFFF" android:textSize="18sp" />

    </GridLayout>
</LinearLayout>