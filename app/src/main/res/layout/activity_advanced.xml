<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F7F7F7"
    android:orientation="vertical"
    android:padding="16dp">

    <Button
        android:id="@+id/btnBackToMain"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:background="?android:attr/selectableItemBackground"
        android:text="@string/nav_back_to_main"
        android:textColor="#FF6B00" />

    <TextView
        android:id="@+id/tvAdvDisplay"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:gravity="bottom|end"
        android:padding="16dp"
        android:text="@string/calc_digit_0"
        android:textColor="#000000"
        android:textSize="48sp"
        android:textStyle="bold" />

    <GridLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:columnCount="3">

        <Button
            android:id="@+id/btnSin"
            style="@style/CalcButton"
            android:text="@string/calc_op_sin"
            android:textColor="#FF6B00" />

        <Button
            android:id="@+id/btnCos"
            style="@style/CalcButton"
            android:text="@string/calc_op_cos"
            android:textColor="#FF6B00" />

        <Button
            android:id="@+id/btnTan"
            style="@style/CalcButton"
            android:text="@string/calc_op_tan"
            android:textColor="#FF6B00" />

        <Button
            android:id="@+id/btnSqrt"
            style="@style/CalcButton"
            android:text="@string/calc_op_sqrt"
            android:textColor="#FF6B00" />

        <Button
            android:id="@+id/btnPow"
            style="@style/CalcButton"
            android:text="@string/calc_op_pow"
            android:textColor="#FF6B00" />

        <Button
            android:id="@+id/btnAdvAC"
            style="@style/CalcButton"
            android:text="@string/calc_op_ac"
            android:textColor="#FF6B00" />
    </GridLayout>
</LinearLayout>