<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Базовый стиль для всех кнопок калькулятора -->
    <style name="CalcButton">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">72dp</item>
        <item name="android:layout_columnWeight">1</item>
        <item name="android:layout_margin">6dp</item>
        <item name="android:background">@drawable/button_number_bg</item>
        <item name="android:textColor">#000000</item>
        <item name="android:textSize">24sp</item>
    </style>

    <style name="CalcButtonAccent" parent="CalcButton">
        <item name="android:background">@drawable/button_accent_bg</item>
        <item name="android:textColor">#FFFFFF</item>
    </style>
</resources>