<resources xmlns:tools="http://schemas.android.com/tools">

    <!-- Базовая тема приложения (устраняет ошибку в манифесте) -->
    <style name="Theme.Lab56" parent="Theme.MaterialComponents.DayNight.NoActionBar">
        <!-- Основные цвета -->
        <item name="colorPrimary">#FF6D00</item>
        <item name="colorOnPrimary">#FFFFFF</item>
        <!-- Тёмный фон приложения -->
        <item name="android:windowBackground">#000000</item>
        <!-- Цвет статус-бара (верхняя панель телефона) -->
        <item name="android:statusBarColor">#000000</item>
    </style>

    <!-- Основной стиль для всех кнопок калькулятора -->
    <style name="CalcButton" parent="Widget.MaterialComponents.Button">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">0dp</item>
        <item name="android:layout_columnWeight">1</item>
        <item name="android:layout_rowWeight">1</item>
        <item name="android:layout_margin">4dp</item>
        <item name="android:textSize">18sp</item>
        <item name="android:textColor">#E0E0E0</item>
        <item name="backgroundTint">#1C1C1C</item>
        <item name="cornerRadius">24dp</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
        <item name="android:insetLeft">0dp</item>
        <item name="android:insetRight">0dp</item>
        <item name="android:padding">0dp</item>
        <item name="android:maxLines">1</item>
        <item name="android:stateListAnimator">@null</item>
    </style>
</resources>