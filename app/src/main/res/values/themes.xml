<resources xmlns:tools="http://schemas.android.com/tools">
    <style name="Base.Theme.Lab56" parent="Theme.Material3.DayNight.NoActionBar">
        <item name="android:statusBarColor">#F7F7F7</item>
        <item name="android:windowLightStatusBar">true</item>
    </style>

    <style name="Theme.Lab56" parent="Base.Theme.Lab56" />

    <!-- Стили кнопок калькулятора Xiaomi -->
    <style name="XiaomiBtn">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">72dp</item>
        <item name="android:layout_columnWeight">1</item>
        <item name="android:layout_margin">5dp</item>
        <item name="android:background">@drawable/btn_number</item>
        <item name="android:textColor">#191919</item>
        <item name="android:textSize">26sp</item>
        <item name="android:stateListAnimator">@null</item>
    </style>

    <style name="XiaomiBtnFunc" parent="XiaomiBtn">
        <item name="android:background">@drawable/btn_func</item>
        <item name="android:textColor">#FF6700</item>
    </style>

    <style name="XiaomiBtnEquals" parent="XiaomiBtn">
        <item name="android:background">@drawable/btn_equals</item>
        <item name="android:textColor">#FFFFFF</item>
    </style>
</resources>