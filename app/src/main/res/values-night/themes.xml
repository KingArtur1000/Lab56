<resources>
    <style name="Base.Theme.Lab56" parent="Theme.Material3.DayNight.NoActionBar">
        <item name="android:windowBackground">#000000</item>
        <item name="android:statusBarColor">#000000</item>
        <item name="android:navigationBarColor">#000000</item>
    </style>

    <style name="Theme.Lab56" parent="Base.Theme.Lab56" />

    <style name="XiaomiDarkBtn">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">72dp</item>
        <item name="android:layout_columnWeight">1</item>
        <item name="android:layout_margin">5dp</item>
        <item name="android:background">@drawable/btn_dark_num</item>
        <item name="android:textColor">#FFFFFF</item>
        <item name="android:textSize">28sp</item>
        <item name="android:stateListAnimator">@null</item>
    </style>

    <style name="XiaomiDarkBtnOrange" parent="XiaomiDarkBtn">
        <item name="android:textColor">#F26C0D</item>
    </style>

    <style name="XiaomiDarkBtnGray" parent="XiaomiDarkBtn">
        <item name="android:textColor">#8E8E93</item>
    </style>

    <style name="XiaomiDarkBtnEquals" parent="XiaomiDarkBtn">
        <item name="android:background">@drawable/btn_dark_equals</item>
        <item name="android:textColor">#FFFFFF</item>
    </style>
</resources>